
<div class="post post-list">

    <div class="post-header index">
        <h1 class="title">
            <a href="<%- url_for(item.path) %>">
                <%- item.title || theme.default_post_title || __('default_post_title') %>
            </a>
        </h1>
        <div class="post-info">
            <% if(item.date) { %>
                <span class="date"><%= item.date.format(config.date_format) %></span>
            <% } %>
            <% if (theme.comments && theme.comments.disqus_shortname) { %>
                <a href="<%- item.permalink %>#disqus_thread" class="comments article-comment-link"><%= __('comment') %></a>
            <% } %>
            <% if(item.categories.first()) { %>
                <span class="category">
                    <a href="<%- config.root + item.categories.first().path  %>"><%- item.categories.first().name %></a>
                </span>
            <% } %>
        </div>
    </div>

    <% if(item.encrypted) { %>
        <div class="content encrypted-post-teaser" data-category="<%= item.encryptedCategory %>" data-cipher="<%= item.encryptedExcerptCipher %>">
            <!-- Same compact-card treatment pdf-viewer.js gives a PDF embed
                 in this same post-list context (see .pdf-compact-card). -->
            <a href="<%- url_for(item.path) %>" class="encrypted-compact-card">
                <i class="fa fa-lock" aria-hidden="true"></i>
                <span class="encrypted-compact-label">This post has been locked</span>
                <span class="encrypted-compact-hint">Enter Password</span>
            </a>
            <!-- Filled in by category-unlock.js's initEncryptedTeasers if this
                 category is already unlocked (sessionStorage) this session. -->
            <div class="encrypted-post-revealed" hidden>
                <div class="content"></div>
                <a href="<%- url_for(item.path) %>" class="read-more">Read More</a>
            </div>
        </div>
    <% } else if(item.excerpt) { %>
        <div class="content">
            <%- item.excerpt %>
        </div>
        <a href="<%- url_for(item.path) %>" class="read-more">Read More</a>
    <% } else { %>
        <div class="content">
            <%- item.content %>
        </div>
    <% } %>

</div>