
<div class="gallery-container">
    <% if (item.photos.length){ %>
        <% item.photos.forEach(function(photo){ %>
            <div class="picture-container">
                <button type="button" class="lightbox-trigger" data-lightbox-src="<%- config.root %><%- photo %>">
                    <img src="<%- config.root %><%- photo %>" class="img-thumbnail" loading="lazy" decoding="async" alt="" />
                </button>
            </div>
        <% }); %>
    <% } %>
</div>