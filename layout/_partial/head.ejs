<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!--
        Content-Security-Policy
        Kept deliberately tight: script-src is 'self' and 'wasm-unsafe-eval' by default.
        Allowed third-party origins are dynamically adapted based on theme features enabled
        (Google Analytics, Disqus, Facebook comments, and font/icon CDNs).
    -->
    <%
        var scriptSrc = ["'self'", "'wasm-unsafe-eval'"];
        var styleSrc = ["'self'", "fonts.googleapis.com", "cdnjs.cloudflare.com"];
        var fontSrc = ["'self'", "fonts.gstatic.com", "cdnjs.cloudflare.com"];
        var imgSrc = ["'self'", "data:", "blob:"];
        var connectSrc = ["'self'"];
        var frameSrc = [];

        if (theme.google_analytics) {
            scriptSrc.push("https://www.google-analytics.com", "https://ssl.google-analytics.com");
            imgSrc.push("https://www.google-analytics.com");
            connectSrc.push("https://www.google-analytics.com");
        }
        if (theme.comments && theme.comments.disqus_shortname) {
            scriptSrc.push("https://*.disqus.com", "https://*.disquscdn.com");
            styleSrc.push("https://*.disquscdn.com");
            imgSrc.push("https://*.disquscdn.com");
            connectSrc.push("https://*.disqus.com", "https://*.disquscdn.com");
            frameSrc.push("https://disqus.com", "https://*.disqus.com");
        }
        if (theme.comments && theme.comments.facebook && theme.comments.facebook.appid) {
            scriptSrc.push("https://connect.facebook.net");
            frameSrc.push("https://www.facebook.com");
        }
        var cspDirectives = [
            "default-src 'self'",
            "script-src " + scriptSrc.join(' '),
            "style-src " + styleSrc.join(' '),
            "font-src " + fontSrc.join(' '),
            "img-src " + imgSrc.join(' '),
            "connect-src " + connectSrc.join(' '),
            "worker-src 'self' blob:",
            "base-uri 'none'",
            "object-src 'none'",
            "form-action 'self'",
            "upgrade-insecure-requests"
        ];
        if (frameSrc.length) {
            cspDirectives.push("frame-src " + frameSrc.join(' '));
        }
    %>
    <meta http-equiv="Content-Security-Policy" content="<%- cspDirectives.join('; ') %>">

    <!--Favicon-->
    <% if (theme.favicon){ %>
        <link rel="icon" href="<%- url_for(theme.favicon) %>">
    <% } %>
    <% if (theme.apple_touch_icon){ %>
        <link rel="apple-touch-icon" sizes="180x180" href="<%- url_for(theme.apple_touch_icon) %>">
    <% } %>

    <!--Description-->
    <% if (page.description){ %>
        <meta name="description" content="<%= page.description %>">
    <% } else if (config.description){ %>
        <meta name="description" content="<%= config.description %>">
    <% } else if (page.excerpt){ %>
        <meta name="description" content="<%= strip_html(page.excerpt).replace(/^\s*/, '').replace(/\s*$/, '') %>">
    <% } else if (page.content){ %>
        <meta name="description" content="<%= strip_html(page.content).replace(/^\s*/, '').replace(/\s*$/, '').substring(0, 150) %>">
    <% } %>

    <!--Author-->
    <% if (config.author){ %>
        <meta name="author" content="<%= config.author %>">
    <% } %>

    <!--Open Graph Title-->
    <% if (page.title){ %>
        <meta property="og:title" content="<%= page.title %>"/>
    <% } else { %>
        <meta property="og:title" content="<%= config.title %>"/>
    <% } %>

    <!--Open Graph Description-->
    <% if (page.description){ %>
        <meta property="og:description" content="<%= page.description %>" />
    <% } else if (config.description) { %>
        <meta property="og:description" content="<%= config.description %>" />
    <% } %>

    <!--Open Graph Site Name-->
    <meta property="og:site_name" content="<%= config.title %>"/>

    <!--Type page-->
    <% if(page.title) { %>
        <meta property="og:type" content="article" />
    <% } else { %>
        <meta property="og:type" content="website" />
    <% } %>

    <!--Page Cover-->
    <% if (page.share_cover) { %>
        <meta property="og:image" content="<%= config.url %><%= page.share_cover %>" />
    <% } else if (config.cover) { %>
        <meta property="og:image" content="<%= config.url %><%= config.cover %>"/>
    <% } %>

    <% if(page.twitter_large_card) { %>
        <meta name="twitter:card" content="summary_large_image" />
    <% } else { %>
        <meta name="twitter:card" content="summary" />
    <% } %>
    <% if(theme.twitter_handle) { %>
        <meta name="twitter:site" content="@<%= theme.twitter_handle %>" />
    <% } %>
    <% if(page.twitter_image) { %>
        <meta name="twitter:image" content="<%= page.twitter_image %>" />
    <% } %>

    <!-- Title -->
    <%
        var title = [];
        if (page.current > 1) title.push(__('page', page.current));
        if (page.title) title.push(page.title);
        if (page.category) title.push(page.category);
        if (page.tag) title.push(page.tag);
        if (page.archive) {
            if (page.year) title.push(__('archive_b', page.year + (page.month ? '/' + page.month : '')));
            else title.push(__('archive_a'));
        }
        title.push(config.title);
    %>
    <title><%= title.join(' - ') %></title>

    <!-- Preconnect to third-party origins actually used -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>

    <!-- Google Fonts (non-blocking: fetched as print, swapped to all by main.js) -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Orbitron:500&family=Open+Sans&display=swap" media="print" data-async-css>
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Orbitron:500&family=Open+Sans&display=swap"></noscript>

    <!-- Font Awesome (icon font, self-hosted CDN mirror with SRI; deferred like the fonts) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" integrity="sha512-SfTiTlX6kk+qitfevl/7LibUOeJWlt9rbyDn92a1DqWOw9vWG2MFoays0sgObmWazO5BQPiFucnnEAjpAB+/Sw==" crossorigin="anonymous" referrerpolicy="no-referrer" media="print" data-async-css>
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" integrity="sha512-SfTiTlX6kk+qitfevl/7LibUOeJWlt9rbyDn92a1DqWOw9vWG2MFoays0sgObmWazO5BQPiFucnnEAjpAB+/Sw==" crossorigin="anonymous" referrerpolicy="no-referrer"></noscript>

    <!-- Custom CSS -->
    <%- css('css/style.css') %>

    <!-- Google Analytics -->
    <%- partial('google-analytics') %>

</head>
