
<!-- Lightbox dialog (shared, used by gallery.ejs) -->
<dialog id="lightbox" class="lightbox">
    <button type="button" class="lightbox-close" aria-label="Close">&times;</button>
    <img class="lightbox-img" src="" alt="">
</dialog>

<!-- Custom JavaScript (vanilla, no jQuery/GSAP/featherlight) -->
<script defer src="<%- url_for('js/main.js') %>"></script>

<%
    // page.content only exists on a single post/page. On index.ejs, `page` is the
    // pagination object (page.posts) instead, so a post embedding {% pdf %} with no
    // <!-- more --> excerpt cut still renders its full content there and needs the
    // same check run against every listed post.
    //
    // For an encrypted post, page.content is ciphertext and won't literally
    // contain "pdf-viewer" — category-encrypt.js checks the plaintext at
    // build time instead and leaves the answer in page.encryptedHasPdf.
    var hasPdfViewer = !!(page.content && page.content.indexOf('pdf-viewer') !== -1) || !!page.encryptedHasPdf;
    if (!hasPdfViewer && page.posts && page.posts.forEach) {
        page.posts.forEach(function (item) {
            if (hasPdfViewer) return;
            if (item.encryptedHasPdf) { hasPdfViewer = true; return; }
            var body = item.excerpt || item.content || '';
            if (body.indexOf('pdf-viewer') !== -1) hasPdfViewer = true;
        });
    }
%>
<% if (hasPdfViewer) { %>
<script type="module" src="<%- url_for('js/pdf-viewer.js') %>"></script>
<% } %>

<%
    // Same page.posts fallback as hasPdfViewer above: article-short.ejs
    // embeds a .encrypted-post-teaser (cipher + category, no plaintext) for
    // each protected post it lists, which category-unlock.js's
    // initEncryptedTeasers needs these scripts loaded to act on — silently
    // revealing the real preview if this visitor already unlocked that
    // category earlier in the session.
    var hasEncryptedPost = !!page.encrypted;
    if (!hasEncryptedPost && page.posts && page.posts.forEach) {
        page.posts.forEach(function (item) {
            if (hasEncryptedPost) return;
            if (item.encrypted) hasEncryptedPost = true;
        });
    }
%>
<% if (hasEncryptedPost) { %>
<!-- crypto.js must load before category-unlock.js (it depends on it); the
     browser's native Web Crypto does the AES-GCM/PBKDF2 work, so there is no
     third-party crypto bundle anymore. -->
<script defer src="<%- url_for('js/crypto.js') %>"></script>
<script defer src="<%- url_for('js/category-unlock.js') %>"></script>
<% } %>

<!-- Disqus Comments -->
<% if (theme.comments && theme.comments.disqus_shortname){ %>
<script type="text/javascript">
    var disqus_shortname = '<%= theme.comments.disqus_shortname %>';

    (function(){
        var dsq = document.createElement('script');
        dsq.type = 'text/javascript';
        dsq.async = true;
        dsq.src = '//' + disqus_shortname + '.disqus.com/<% if (page.comments){ %>embed.js<% } else { %>count.js<% } %>';
        (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(dsq);
    }());
</script>
<% } %>
